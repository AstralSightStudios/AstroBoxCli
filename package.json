{
  "name": "astrobox-cli",
  "version": "0.1.5",
  "description": "AstroBox command line interface",
  "type": "module",
  "bin": {
    "astrobox-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "rolldown -c -w",
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "cli": "bun run ./src/cli.ts"
  },
  "keywords": [
    "astrobox",
    "cli",
    "node"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.8.1",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rolldown": "^1.0.0-rc.16",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "commander": "^14.0.0"
  }
}
